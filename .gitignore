# Local input and output dirs
src/
out/

# Legacy frame cache location.
.cache/

# test/fixtures/ IS committed on purpose — the suite asserts bit-exact hex
# values, so the inputs must be fixed rather than regenerated by whatever
# ImageMagick version happens to be installed. Regenerate with
# `test/run.sh --regen` only when you mean to change them.
# Scratch from a run is not committed:
test/work/
test/themes.test.conf

.DS_Store

# AI Folders - do not commit, derive from AGENTS.md
.claude
.clinerules
.opencode
.windsurf
.cursor
